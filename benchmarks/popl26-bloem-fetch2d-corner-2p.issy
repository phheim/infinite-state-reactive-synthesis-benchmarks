input int nx
input int ny

state int width
state int height

state int x
state int y
state int tx
state int ty

def atTarget = [x = tx] && [y = ty]

def move = ([x' = x + 1] && [y' = y]) || ([x' = x] && [y' = y]) || ([x' = x - 1] && [y' = y]) || ([y' = y + 1] && [x' = x]) || ([y' = y - 1] && [x' = x])
def updateTarget = [tx' = nx] && [ty' = ny]

def validInitialState = [0 <= x] && [x <= width+1] && [0 <= tx] && [tx <= width+1] && [0 <= y] && [y <= height+1] && [0 <= ty] && [ty <= height+1] && !([x > 1] && [y > 1]) && !([tx > 1] && [ty > 1]) && [width > 0] && [height > 0]
def safeState = [x >= 0] && [x <= width+1] && [y >= 0] && [y <= height+1] && !([x > 1] && [y > 1]) && !([tx > 1] && [ty > 1])
def validEnvInput = [nx >= 0] && [nx <= width+1] && [ny >= 0] && [ny <= height+1] && !([nx > 1] && [ny > 1])

formula {
    assert G F atTarget
 }


game Safety from linit {
    loc linit 1
    loc run 1
    loc target 1
    loc done 1
    loc err 0
    
    from linit to done with !validInitialState
    from linit to run with validInitialState && keep(x y tx ty width height)
    from run to done with !validEnvInput
    from run to err with !safeState

    from run to run with !atTarget && move && keep(tx ty width height)
    from run to target with atTarget && keep(x y tx ty width height)
    from target to run with validEnvInput && updateTarget && keep(x y width height)
    from target to done with !validEnvInput

    from done to done with true 
    from err to err with keep(x y tx ty width height)
}