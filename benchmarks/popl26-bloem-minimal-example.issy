input bool stop

state int x
state int max

formula {
    assume G F ![stop]
    assert G F [x = 0]
    assert G F [x = max]
 }

def validInitialState = [x = 0] && [max >= 0]
def safeState = [x >= 0] && [x <= max]
def validEnvInput = true
def move = (![stop] && [x' = x + 1]) || (![stop] && [x' = x - 1]) || ([x' = x])

game Safety from linit {
    loc linit 1
    loc run 1
    loc done 1
    loc err 0
   
    from linit to done with !validInitialState
    from linit to run with validInitialState && keep(x max)
    from run to done with !validEnvInput
    from run to err with !safeState
    from run to run with safeState && move && keep(max)

    from done to done with true 
    from err to err with keep(x max)
 } 