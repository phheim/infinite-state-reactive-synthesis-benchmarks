input int delivery
input int efficiency

state int usage1
state int usage2

state int consumer1
state int consumer2
state int depot


def full = [consumer1 = usage1] && [consumer2 = usage2]


def validInitialState = [usage1 >= 1] && [usage2 >= 1] && [consumer1 = usage1] && [consumer2 = usage2] && [depot = usage1 + usage2]
def safeState = [consumer1 >= 0] && [consumer1 <= usage1+2] && [consumer2 >= 0] && [consumer2 <= usage2+2] && [depot >= 0] && [depot <= usage1 + usage2 + 2] && [depot + consumer1 + consumer2 >= usage1 + usage2]
def validEnvInput = [delivery >= usage1 + usage2] && [delivery <= usage1 + usage2 + 2] && [efficiency >= 0] && [efficiency <= 1]
def movesNotFull = ([consumer1' = consumer1 + 1] && [consumer2' = consumer2] && [depot' = depot - 1]) || 
                   ([consumer1' = consumer1] && [consumer2' = consumer2 + 1] && [depot' = depot - 1])

def moveFull = ([consumer1' = consumer1 - usage1 + efficiency] && [consumer2' = consumer2 - usage2 + efficiency] && [depot' = delivery])
           


formula {
    assert G F full
 }


game Safety from linit {
    loc linit 1
    loc run 1
    loc target 1
    loc done 1
    loc err 0
    
    from linit to done with !validInitialState
    from linit to run with validInitialState && keep(consumer1 consumer2 depot usage1 usage2)
    from run to done with !validEnvInput
    from run to err with !safeState

    from run to run with !full && movesNotFull && keep(usage1 usage2)
    from run to target with full && keep(consumer1 consumer2 depot usage1 usage2)
    from target to run with validEnvInput && moveFull && keep(usage1 usage2)
    from target to done with !validEnvInput

    from done to done with true 
    from err to err with keep(consumer1 consumer2 depot usage1 usage2)
}