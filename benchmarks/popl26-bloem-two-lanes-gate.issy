input bool gate0
input bool gate1

state int size

state int x
state int lane

formula {
    assume G F [gate0]
    assume G F [gate1]
    assert G F [x = 0]
    assert G F [x = size]
 }

def validInitialState = [size > 1] && [x >= 0] && [x <= size] && [lane >= 0] && [lane <= 1]
def safeState = [x >= 0] && [x <= size] && [lane >= 0] && [lane <= 1]
def validEnvInput = true
def move = (((gate0 && [x = size-1] && [lane=0]) || (gate1 && [x = size-1] && [lane=1]) || ![x = size-1]) && [x' = x + 1] && [lane' = lane]) || (((gate0 && [x = size] && [lane=0]) || (gate1 && [x = size] && [lane=1]) || ![x = size]) && [x' = x - 1] && [lane' = lane]) || ([x' = x] && [lane' = lane]) || ([x' = x] && [lane' = lane+1]) || ([x' = x] && [lane' = lane-1])

game Safety from linit {
    loc linit 1
    loc run 1
    loc done 1
    loc err 0
   
    from linit to done with !validInitialState
    from linit to run with validInitialState && keep(x lane size)
    from run to done with !validEnvInput
    from run to err with !safeState
    from run to run with safeState && move && keep(size)

    from done to done with true 
    from err to err with keep(x lane size)
 } 