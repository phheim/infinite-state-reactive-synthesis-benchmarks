input bool obstacle

state int x
state int target

formula {
    assume G F ![obstacle]
    assert G F [x = 0]
    assert G F [x = target]
 }

def validPos = ([x >= 0] && [x <= target]) || ([x >= target] && [x <= 0])
def validInitialState = validPos
def safeState = validPos
def validEnvInput = true
def move = (!obstacle && [x' = x + 1]) || (!obstacle && [x' = x - 1]) || [x' = x]

game Safety from linit {
    loc linit 1
    loc run 1
    loc done 1
    loc err 0
   
    from linit to done with !validInitialState
    from linit to run with validInitialState && keep(x target)
    from run to done with !validEnvInput
    from run to err with !safeState
    from run to run with safeState && move && keep(target)

    from done to done with true 
    from err to err with keep(x target)
 } 